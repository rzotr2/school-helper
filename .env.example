# Supabase project settings (Project Settings → API)
# The anon/publishable key is safe for the frontend. Never put the service_role key here.
# VITE_SUPABASE_URL must be the bare Project URL — NOT the REST endpoint.
# Pasting "...supabase.co/rest/v1" here breaks Auth redirects (PostgREST 401).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-ANON-KEY"
