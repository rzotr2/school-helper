{
  "entities": {
    "SchoolProfile": {
      "title": "SchoolProfile",
      "description": "User's school workspace profile",
      "type": "object",
      "properties": {
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "A school subject",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "position": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["ownerId", "name", "position", "createdAt", "updatedAt"]
    },
    "Topic": {
      "title": "Topic",
      "description": "A topic within a subject",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "position": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["ownerId", "subjectId", "name", "position", "createdAt", "updatedAt"]
    },
    "Document": {
      "title": "Document",
      "description": "A PDF document belonging to a topic",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "topicId": { "type": "string", "maxLength": 128 },
        "originalName": { "type": "string", "maxLength": 255 },
        "storagePath": { "type": "string", "maxLength": 500 },
        "mimeType": { "type": "string" },
        "size": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["ownerId", "topicId", "originalName", "storagePath", "mimeType", "size", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "schoolProfiles/{userId}": {
      "schema": { "$ref": "#/entities/SchoolProfile" },
      "description": "User's school profile. Document ID MUST be the Firebase Auth UID."
    },
    "subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Subjects belonging to users."
    },
    "topics/{topicId}": {
      "schema": { "$ref": "#/entities/Topic" },
      "description": "Topics belonging to subjects."
    },
    "documents/{documentId}": {
      "schema": { "$ref": "#/entities/Document" },
      "description": "Uploaded PDF documents metadata."
    }
  }
}
